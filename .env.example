# Enchanted Castle — environment variables
# Copy to .env and fill in values before running

# Server
PORT=8000
DEBUG=false

# Database (fill in once DB type is decided)
# DATABASE_URL=sqlite:///./enchanted_castle.db
# DATABASE_URL=postgresql://user:password@localhost:5432/enchanted_castle

# Session secrets
SECRET_KEY=change-me-to-a-random-secret
